# Copy to apps/api/.env and adjust. Never commit a filled-in .env (NFR-403).

AGRI_ENVIRONMENT=local
AGRI_DEBUG=true

AGRI_DATABASE_URL=postgresql+psycopg://agrivardhak:agrivardhak@localhost:5433/agrivardhak

# Hosted (Supabase, ADR-0019). Take the **session pooler** URI from Dashboard → Connect —
# port 5432, not the direct connection (IPv6-only, unreachable from Render) and not the
# transaction pooler on 6543 (no prepared statements). Copy it rather than assembling it:
# the aws-N prefix varies. Change the scheme to postgresql+psycopg:// and percent-encode
# the password (@ → %40, # → %23, / → %2F). Exported in the shell for a one-off migration
# or seed; on Render it lives in the service environment, never in a file.
# AGRI_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGRI_JWT_SECRET=dev-only-not-a-real-secret

AGRI_ANTHROPIC_API_KEY=

# data.gov.in API key, for seed/fetch_datagovin.py. Read from the shell, not from
# apps/api/.env — the seed fetchers run outside the API venv. Never commit a real key.
DATA_GOV_IN_API_KEY=
AGRI_ORCHESTRATOR_MODEL=claude-sonnet-5

# The intent router (ADR-0011). AGRI_LLM_PROVIDER selects the provider for it; leaving the
# key empty is a supported state — routing falls back to keywords (NFR-303).
AGRI_LLM_PROVIDER=sarvam          # nvidia | sarvam | anthropic | none
AGRI_SARVAM_API_KEY=
# sarvam-105b-conversations, not the 128K sarvam-105b flagship — the flagship missed the
# router's 8s budget on nearly every real-payload call (measured, not assumed; ADR-0022).
AGRI_SARVAM_BASE_URL=https://api.sarvam.ai/v1
AGRI_NVIDIA_API_KEY=
AGRI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Providers retire models without warning, and a dead model does not raise — routing falls
# back to keywords and every question becomes a Decision Packet (ADR-0020). If answers stop
# matching the questions, check `fell_back` on the routing event first. Re-run
# `make routing-eval` after changing this — do not trust a model choice un-measured (ADR-0022).
AGRI_ROUTER_MODEL=sarvam-105b-conversations

# Page translation (ADR-0023) — same AGRI_SARVAM_API_KEY. mayura:v1 beat sarvam-translate:v1 on
# `make translation-eval` (28/29 vs 24/29, and the newer model's misses changed meaning).
# Re-run the eval before changing it. With no key, pages stay in their source language.
AGRI_SARVAM_TRANSLATE_MODEL=mayura:v1
# Machine translations per hour shared by all signed-out callers (the sign-in page).
AGRI_TRANSLATE_ANONYMOUS_BUDGET_PER_HOUR=200

# Browser origins allowed to call the API. Parsed as JSON because it is a list[str] — a bare
# comma-separated string raises at startup. In production this is the Vercel domain:
# AGRI_CORS_ORIGINS=["https://<your-app>.vercel.app"]
AGRI_CORS_ORIGINS=["http://localhost:3000"]

# LLM kill-switch. It does *not* touch the ingestion adapters — those always read the
# committed files. true skips narration and the assistant model call (NFR-303); a live
# deployment wants false plus real keys.
AGRI_USE_FIXTURES=false

# Dev only: a CEO bearer token so the web tier can call the API before NextAuth lands.
# Get one with `make dev-token`.
AGRI_DEV_TOKEN=
